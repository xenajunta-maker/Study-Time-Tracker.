<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.PasswordField?>

<StackPane xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="org.example.studytracker.AuthController"
           prefWidth="1000" prefHeight="640"
           styleClass="auth-root">

    <VBox styleClass="auth-card" spacing="12"
          prefWidth="420" maxWidth="420" maxHeight="-Infinity">

        <Label text="StudyTrack" styleClass="auth-brand"/>
        <Label fx:id="lblAuthTitle" text="Welcome back" styleClass="auth-title"/>
        <Label fx:id="lblAuthSubtitle" text="Sign in to continue to your dashboard."
               styleClass="auth-subtitle" wrapText="true"/>

        <!-- ── Sign in ─────────────────────────────────────── -->
        <VBox fx:id="loginForm" spacing="8">
            <Label text="Username" styleClass="form-label"/>
            <TextField fx:id="loginUsername" promptText="Your username"/>

            <Label text="Password" styleClass="form-label"/>
            <PasswordField fx:id="loginPassword" promptText="Your password"
                           onAction="#handleLogin"/>

            <Label fx:id="lblLoginError" styleClass="error-label" wrapText="true"/>

            <Button text="Sign In" styleClass="btn-primary" maxWidth="Infinity"
                    onAction="#handleLogin"/>

            <HBox alignment="CENTER" spacing="4">
                <Label text="New here?" styleClass="auth-hint"/>
                <Button text="Create an account" styleClass="link-button"
                        onAction="#showRegister"/>
            </HBox>
        </VBox>

        <!-- ── Create account ──────────────────────────────── -->
        <VBox fx:id="registerForm" spacing="8" visible="false" managed="false">
            <Label text="Full name" styleClass="form-label"/>
            <TextField fx:id="regFullName" promptText="e.g. Ama Mensah"/>

            <Label text="Username" styleClass="form-label"/>
            <TextField fx:id="regUsername" promptText="3-20 letters, numbers or _"/>

            <Label text="Password" styleClass="form-label"/>
            <PasswordField fx:id="regPassword" promptText="At least 8 characters, with a letter and a number"/>

            <Label text="Confirm password" styleClass="form-label"/>
            <PasswordField fx:id="regConfirm" promptText="Re-enter your password"
                           onAction="#handleRegister"/>

            <Label fx:id="lblRegisterError" styleClass="error-label" wrapText="true"/>

            <Button text="Create Account" styleClass="btn-primary" maxWidth="Infinity"
                    onAction="#handleRegister"/>

            <HBox alignment="CENTER" spacing="4">
                <Label text="Already have an account?" styleClass="auth-hint"/>
                <Button text="Sign in" styleClass="link-button" onAction="#showLogin"/>
            </HBox>
        </VBox>
    </VBox>
</StackPane>
